# Copy this to backend/.env, then replace the development-only organizer key.
EVENTMESH_ORGANIZER_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
# Configure only in an authorized PayPal sandbox account. Leave empty for preview-only demo.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional Render configuration (do not use for a public registration form):
# EVENTMESH_DB_PATH=/var/data/events.db
# EVENTMESH_BOOTSTRAP_ORGANIZER_EMAIL=organizer@example.com
# EVENTMESH_BOOTSTRAP_ORGANIZER_PASSWORD=USE_A_UNIQUE_12_PLUS_CHARACTER_PASSWORD
# EVENTMESH_PUBLIC_FRONTEND_URL=https://your-frontend.onrender.com
# EVENTMESH_ENABLE_REGISTRATION=false
