# Copy this file to frontend/.env.local. NEVER use NEXT_PUBLIC_ for the organizer key.
EVENTMESH_BACKEND_URL=http://127.0.0.1:8000
EVENTMESH_ORGANIZER_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# Hosted frontend options (set only in Render's private Environment UI):
# EVENTMESH_ENABLE_PRODUCTION_BRIDGE=true
# EVENTMESH_PUBLIC_FRONTEND_URL=https://your-frontend.onrender.com
# EVENTMESH_ENABLE_PRODUCTION_SANDBOX_CHECKOUT=true
