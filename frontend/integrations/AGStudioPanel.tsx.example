"use client";
// Requires: npm install ag-studio-react (automatically installs ag-studio)
// Official React embedded analytics: https://www.ag-grid.com/studio/react/installation/
import { AgStudio } from "ag-studio-react";
import type { EventRecord, Room, Session, Ticket } from "@/lib/api";

export default function EventMeshAGStudio({ events, rooms, sessions, tickets }: {
  events: EventRecord[]; rooms: Room[]; sessions: Session[]; tickets: Ticket[];
}) {
  const sources = [
    { id: "events", data: events.map((e) => ({ id: e.id, title: e.title, eventDate: e.event_date, venue: e.venue, capacity: e.capacity })) },
    { id: "rooms", data: rooms.map((r) => ({ id: r.id, name: r.name, capacity: r.capacity })) },
    { id: "sessions", data: sessions.map((s) => ({ id: s.id, title: s.title, room: s.room, speaker: s.speaker, startTime: s.start_time, endTime: s.end_time })) },
    { id: "tickets", data: tickets.map((t) => ({ id: t.id, name: t.name, capacity: t.capacity, available: t.available, priceUSD: Number(t.price_usd) })) },
  ];
  return <div style={{ height: 620, width: "100%" }}><AgStudio data={{ sources }} mode="edit" /></div>;
}
